{
    "version": 2,
    "builds": [
        { "src": "bin/index.js", "use": "@vercel/node" }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "bin/index.js",
            "headers": {
                "Access-Control-Allow-Origin": "*",
                "Access-Control-Allow-Methods": "GET,OPTIONS,POST,PUT,PATCH,DELETE",
                "Access-Control-Allow-Headers": "Authorization, Role, Content-Type, Accept"
            }
        }
    ]
}
